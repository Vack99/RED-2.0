{
  "regions": ["pdx1"],
  "crons": [
    {
      "path": "/api/cron/alertas",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=86400"
        }
      ]
    }
  ]
}
